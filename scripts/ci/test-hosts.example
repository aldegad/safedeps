# The hosts scripts/ci/run-on-hosts.sh runs the suite on. Copy this file to
# ~/.config/safedeps/test-hosts (or pass --hosts-file) and fill in your own
# hosts there; host addresses do not belong in a public repository.
#
# One host per line, seven fields separated by `|`:
#
#   name|ssh destination|ssh options|cpus|queue|PATH prefix|runs directory
#
#   name             lower-case letters, digits and dashes; --hosts picks by it
#   ssh destination  user@address, or a Host alias from ~/.ssh/config
#   ssh options      extra ssh words; a word starting with ~/ is a local path
#   cpus             how many of the host's CPUs the run may keep busy
#   queue            the command that waits for the host's turn, given an
#                    owner name and the command to hold it with, or - for none
#   PATH prefix      put before the host's PATH for every unit; may use $HOME
#   runs directory   under the remote home; each run makes a directory there
#                    and removes it once its logs are collected
#
# A Linux host and a macOS host each run every unit they are given; to test
# both platforms, run once with --hosts naming the macOS hosts and once with
# the Linux ones.
mac-a|tester@mac-a.example|-i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes|6|~/safedeps-runs/slot.sh|$HOME/.local/node/bin|safedeps-ci
mac-b|tester@mac-b.example||8|~/safedeps-runs/slot.sh|$HOME/.local/node/bin|safedeps-ci
