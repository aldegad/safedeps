[
  {
    "id": "W1",
    "label": "double-quoted spec",
    "text": "@@M@@ install \"evil==1.0.0\"",
    "argv": {
      "bash": [
        "install",
        "evil==1.0.0"
      ],
      "zsh": [
        "install",
        "evil==1.0.0"
      ]
    }
  },
  {
    "id": "W2",
    "label": "single-quoted spec",
    "text": "@@M@@ install 'evil==1.0.0'",
    "argv": {
      "bash": [
        "install",
        "evil==1.0.0"
      ],
      "zsh": [
        "install",
        "evil==1.0.0"
      ]
    }
  },
  {
    "id": "W3",
    "label": "backslash outside quotes",
