#!/usr/bin/env bash
# safedeps — multi-ecosystem dependency install safety gate (CLI).
# Phase 1 advisory gate: OSV (canonical) + CISA KEV (overlay) + GHSA (enrichment)
# → approved-spec ledger write. The hooks (safedeps-core, run through
# scripts/safedeps-hook-entry.sh) read and enforce the ledger; this CLI is the
# only place that writes it.

set -euo pipefail

SAFEDEPS_VERSION="2.24.0"

# ---- repo / lib bootstrap ----------------------------------------------------

# Resolve the symlink chain to the real script before deriving the repo dir.
# A global install (npm -g, or ~/.local/bin via --link-bin) puts a FILE symlink
# at <prefix>/bin/safedeps; ${BASH_SOURCE[0]} keeps that symlink path, so a naive
# dirname/.. lands on <prefix> and `source <prefix>/lib/providers/providers.sh`
# fails. Walk to the link target first. (readlink -f is non-portable on macOS, so
# loop with bare readlink + cd -P.)
SAFEDEPS_SOURCE="${BASH_SOURCE[0]}"
while [[ -h "${SAFEDEPS_SOURCE}" ]]; do
  SAFEDEPS_BIN_DIR=$(cd -P "$(dirname "${SAFEDEPS_SOURCE}")" && pwd)
  SAFEDEPS_SOURCE=$(readlink "${SAFEDEPS_SOURCE}")
  [[ "${SAFEDEPS_SOURCE}" != /* ]] && SAFEDEPS_SOURCE="${SAFEDEPS_BIN_DIR}/${SAFEDEPS_SOURCE}"
done
SAFEDEPS_BIN_DIR=$(cd -P "$(dirname "${SAFEDEPS_SOURCE}")" && pwd)
SAFEDEPS_REPO_DIR=$(cd -P "${SAFEDEPS_BIN_DIR}/.." && pwd)

# shellcheck source=../lib/providers/providers.sh
source "${SAFEDEPS_REPO_DIR}/lib/providers/providers.sh"
# shellcheck source=../lib/ledger/ledger.sh
source "${SAFEDEPS_REPO_DIR}/lib/ledger/ledger.sh"
# shellcheck source=../lib/npm/closure.sh
source "${SAFEDEPS_REPO_DIR}/lib/npm/closure.sh"
# shellcheck source=../lib/ledger/recheck-report.sh
source "${SAFEDEPS_REPO_DIR}/lib/ledger/recheck-report.sh"

SAFEDEPS_HOME="${SAFEDEPS_HOME:-${HOME}/.safedeps}"
SAFEDEPS_LEDGER_DIR="${SAFEDEPS_LEDGER_DIR:-${SAFEDEPS_HOME}/approved-specs}"
# Derived, never taken from the environment — see lib/providers/providers.sh for
# why: this file is where every bypass is recorded. providers.sh is sourced
# above and captured the environment value before overwriting it, so the notice
# below quotes what the user set.
SAFEDEPS_ADVISORY_LOG="${SAFEDEPS_HOME}/advisory.log"

# ---- output mode -------------------------------------------------------------

SAFEDEPS_JSON_MODE=0
SAFEDEPS_NO_COLOR=0

sf_color_init() {
  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]] || [[ "${SAFEDEPS_NO_COLOR}" -eq 1 ]] || [[ -n "${NO_COLOR:-}" ]] || [[ ! -t 1 ]]; then
    C_RED=''; C_YELLOW=''; C_GREEN=''; C_GRAY=''; C_BOLD=''; C_DIM=''; C_RESET=''
  else
    C_RED=$'\033[31m'
    C_YELLOW=$'\033[33m'
    C_GREEN=$'\033[32m'
    C_GRAY=$'\033[90m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RESET=$'\033[0m'
  fi
}

sf_human() { [[ "${SAFEDEPS_JSON_MODE}" -eq 0 ]]; }

sf_info() { sf_human || return 0; printf '%s· %s%s\n' "${C_GRAY}" "$1" "${C_RESET}"; }
sf_ok()   { sf_human || return 0; printf '%s✓ %s%s\n' "${C_GREEN}" "$1" "${C_RESET}"; }
sf_warn() { sf_human || return 0; printf '%s⚠ %s%s\n' "${C_YELLOW}" "$1" "${C_RESET}"; }
sf_err()  { sf_human || return 0; printf '%s✗ %s%s\n' "${C_RED}" "$1" "${C_RESET}"; }

sf_eprintf() { printf '%s\n' "$*" >&2; }

# Lightweight spinner. No-op in JSON mode or non-tty.
SF_SPINNER_PID=""
sf_spinner_start() {
  sf_human || return 0
  [[ -t 1 ]] || return 0
  local label="$1"
  (
    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local i=0
    while :; do
      printf '\r%s%s%s %s' "${C_GRAY}" "${frames[$i]}" "${C_RESET}" "${label}" >&2
      i=$(( (i + 1) % ${#frames[@]} ))
      sleep 0.08
    done
  ) &
  SF_SPINNER_PID=$!
  disown "${SF_SPINNER_PID}" 2>/dev/null || true
}

sf_spinner_stop() {
  [[ -n "${SF_SPINNER_PID}" ]] || return 0
  kill "${SF_SPINNER_PID}" 2>/dev/null || true
  wait "${SF_SPINNER_PID}" 2>/dev/null || true
  SF_SPINNER_PID=""
  sf_human && printf '\r\033[2K' >&2 || true
}

trap 'sf_exit_status=$?; sf_spinner_stop; sf_check_finish "${sf_exit_status}"' EXIT

# ---- helpers -----------------------------------------------------------------

sf_require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    sf_eprintf "safedeps: jq is required"
    exit 4
  fi
}

sf_mktemp_evidence() {
  local tmp_dir="${TMPDIR:-/tmp}"

  mkdir -p "${tmp_dir}"
  mktemp "${tmp_dir%/}/safedeps-evidence.XXXXXX"
}

# parse "pkg@range" or "@scope/pkg@range" → pkg / range
sf_parse_pkg_spec() {
  local input="$1"
  local pkg range
  if [[ "${input}" =~ ^(.+)@([^@]+)$ ]]; then
    pkg="${BASH_REMATCH[1]}"
    range="${BASH_REMATCH[2]}"
  else
    pkg="${input}"
    range=""
  fi
  printf '%s\n%s' "${pkg}" "${range}"
}

# heuristic — does this look like a semver range rather than a concrete version?
sf_is_range() {
  local v="$1"
  [[ -z "${v}" ]] && return 1
  case "${v}" in
    \^*|\~*|\**|\>*|\<*|\=*) return 0 ;;
  esac
  [[ "${v}" == *"||"* ]] && return 0
  [[ "${v}" == *" - "* ]] && return 0
  return 1
}

# resolve a range to a concrete installable version via the ecosystem tool.
# Caller is responsible for handling resolve failure (returns 1).
sf_resolve_version() {
  local ecosystem="$1" pkg="$2" range="$3"

  if [[ -z "${range}" ]]; then
    sf_eprintf "safedeps: missing version — usage: <ecosystem> <pkg>@<version|range>"
    return 1
  fi

  if ! sf_is_range "${range}"; then
    printf '%s' "${range}"
    return 0
  fi

  case "${ecosystem}" in
    npm)
      if ! command -v npm >/dev/null 2>&1; then
        sf_eprintf "safedeps: npm CLI required to resolve range '${range}' for ${pkg}"
        return 1
      fi
      local resolved
      resolved=$(npm view "${pkg}@${range}" version --json 2>/dev/null \
        | jq -r 'if type=="array" then .[-1] elif type=="string" then . else empty end' 2>/dev/null) || resolved=""
      [[ -n "${resolved}" ]] || {
        sf_eprintf "safedeps: could not resolve ${pkg}@${range} via npm view"
        return 1
      }
      printf '%s' "${resolved}"
      ;;
    *)
      sf_eprintf "safedeps: range resolution for ecosystem '${ecosystem}' not implemented yet — pass a concrete version"
      return 1
      ;;
  esac
}

# Extract fixed version candidates greater than current_version from OSV vulns.
# Echoes unique candidates in ascending version order, bounded for deterministic
# provider retry behavior.
sf_extract_patched_versions() {
  local provider_json_file="$1" current_version="$2"
  local fixed
  fixed=$(jq -r '
    [ .vulnerabilities[]?.affected[]?.ranges[]?.events[]?.fixed // empty ]
    | unique
    | .[]
  ' "${provider_json_file}" 2>/dev/null)

  [[ -z "${fixed}" ]] && return 1

  while IFS= read -r v; do
    [[ -z "${v}" ]] && continue
    # require v > current_version
    local higher
    higher=$(printf '%s\n%s\n' "${v}" "${current_version}" | sort -V | tail -1)
    [[ "${higher}" != "${v}" || "${v}" == "${current_version}" ]] && continue
    printf '%s\n' "${v}"
  done <<< "${fixed}" | sort -Vu | head -20
}

sf_advisory_log() {
  umask 077
  mkdir -p "$(dirname "${SAFEDEPS_ADVISORY_LOG}")"
  # Same once-per-process retention check the provider writer does. Both write
  # this file directly, so a run that never reaches a provider (a ledger listing,
  # an empty re-check) must still be a run that can rotate it.
  safedeps_advisory_log_rotate_once
  printf '[%s] %s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$*" >> "${SAFEDEPS_ADVISORY_LOG}"
}

# The ledger's files, into SF_LEDGER_FILES. A find that failed is no listing: in
# a process substitution nothing sees its exit, and an unreadable ledger read as
# an empty one, so a re-check checked nothing and said it had finished.
SF_LEDGER_FILES=()
sf_ledger_files() {
  local listing f

  SF_LEDGER_FILES=()
  listing=$(sf_mktemp_evidence) || return 1
  if ! find "${SAFEDEPS_LEDGER_DIR}" -maxdepth 1 -name '*.json' -type f -print0 > "${listing}" 2>/dev/null; then
    rm -f "${listing}"
    return 1
  fi
  while IFS= read -r -d '' f; do
    SF_LEDGER_FILES+=("${f}")
  done < "${listing}"
  rm -f "${listing}"
}

sf_ledger_unlisted() {
  local command="$1"

  sf_err "the ledger could not be listed: ${SAFEDEPS_LEDGER_DIR}"
  sf_advisory_log "${command} fail-closed ledger-unlisted" || true
  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    jq -nc --arg command "${command}" '{command:$command, error:"ledger_unlisted"}'
  fi
}

# The results `safedeps check` reports, declared once. SKILL.md's table under
# "Then act on `result`" lists these and no other (smoke.sh holds the two to
# each other).
SAFEDEPS_CHECK_CLEAN="clean"
SAFEDEPS_CHECK_ALREADY_APPROVED="already_approved"
SAFEDEPS_CHECK_PATCHED_AVAILABLE="patched_available"
SAFEDEPS_CHECK_CLOSURE_VULNERABLE="closure_vulnerable"
SAFEDEPS_CHECK_CVE_UNPATCHED="cve_unpatched"
SAFEDEPS_CHECK_KEV_HARD_BLOCK="kev_hard_block"
SAFEDEPS_CHECK_PATCHED_STILL_VULNERABLE="patched_still_vulnerable"
SAFEDEPS_CHECK_PROVIDER_UNAVAILABLE="provider_unavailable"
SAFEDEPS_CHECK_ERROR="error"

# Print the `check --json` report, assembled in one place for every result:
#   sf_check_json RESULT ECOSYSTEM PACKAGE RANGE BASE HEAD TAIL [jq args...]
# BASE is what the report starts from (`{}`, or `.` to extend the provider's
# answer on stdin), HEAD the fields between input_range and result, TAIL the
# fields after result. The jq arguments bind what HEAD and TAIL name and give
# the input; a field keeps its place in the report. TAIL may call
# install_hint(version), the status names of SAFEDEPS_STATUS_JQ and the
# closure source fields of SAFEDEPS_NPM_SOURCE_JQ. sf_check_render makes the
# report and sf_check_say prints it, which an approval needs apart: the report is
# made before the approval is written, and printed after.
sf_check_render() {
  local result="$1" ecosystem="$2" package="$3" range="$4" base="$5" head="$6" tail="$7"
  shift 7
  jq -c --arg result "${result}" --arg ecosystem "${ecosystem}" --arg package "${package}" --arg range "${range}" \
    "${SAFEDEPS_STATUS_JQ}${SAFEDEPS_NPM_SOURCE_JQ}"'def install_hint($v): "install with " + $package + "@" + $v; '"(${base}) + {command:\"check\", ecosystem:\$ecosystem, package:\$package, input_range:\$range} + (${head}) + {result:\$result} + (${tail})" "$@"
}

sf_check_say() {
  sf_human && return 0
  printf '%s\n' "$1"
  SF_CHECK_REPORTED=1
}

sf_check_json() {
  local report

  report=$(sf_check_render "$@") || return 1
  sf_check_say "${report}"
}

# A check ends in one report and one of the exit statuses it documents. A command
# that stopped the run under set -e left neither: no report, and jq's own status.
# That run answers here, and what it says is true, because an approval is the
# last thing a check does that can fail (sf_check_commit): a run that stops has
# approved nothing.
SF_CHECK_RUNNING=0
SF_CHECK_REPORTED=0
sf_check_finish() {
  local status="$1"

  [[ "${SF_CHECK_RUNNING}" -eq 1 ]] || return 0
  [[ "${status}" -ne 0 ]] || return 0
  case "${status}" in
    2|3|4) { sf_human || [[ "${SF_CHECK_REPORTED}" -eq 1 ]]; } && return 0 ;;
  esac
  sf_err "the check did not finish — fail-closed, nothing approved"
  sf_advisory_log "check fail-closed did-not-finish status=${status}" || true
  if [[ "${SF_CHECK_REPORTED}" -eq 0 ]] && ! sf_human; then
    printf '{"command":"check","result":"%s","approved":false,"error":"check_did_not_finish"}\n' "${SAFEDEPS_CHECK_ERROR}"
  fi
  exit 4
}

# What a check says when a provider gave no answer, or an answer with no status
# of the list: nothing is approved, and it is a result of its own. The caller
# removes its files and returns 4.
#   sf_check_unavailable ECOSYSTEM PACKAGE RANGE VERSION REASON [CANDIDATE]
# CANDIDATE is the patch candidate whose answer it was, where there was one.
SF_UNAVAILABLE_PRIMARY="OSV or CISA KEV did not answer, or answered unreadably"
SF_UNAVAILABLE_BATCH="OSV batch or CISA KEV did not answer for the full closure, or answered unreadably"
sf_check_unavailable() {
  local ecosystem="$1" package="$2" range="$3" version="$4" reason="$5" candidate="${6:-}"

  sf_err "${reason} — fail-closed"
  sf_advisory_log "check fail-closed ecosystem=${ecosystem} package=${package} version=${candidate:-${version}}"
  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    sf_check_json "${SAFEDEPS_CHECK_PROVIDER_UNAVAILABLE}" "${ecosystem}" "${package}" "${range}" '{}' \
      '{resolved_version:$version} + (if $candidate == "" then {} else {suggested_spec:$candidate} end)' \
      '{approved:false, error:$reason}' \
      -n --arg version "${version}" --arg candidate "${candidate}" --arg reason "${reason}"
  fi
}

# The same for an approval that could not be written (sf_check_commit names
# why): every approval a report states is one this check committed, the hook
# will find, and the approvals store vouches for. A report never states one
# another check made. An approval in doubt is neither stated nor said to be
# absent. The caller removes its files and returns 4.
sf_check_not_written() {
  local ecosystem="$1" package="$2" range="$3" version="$4"
  local failure="${SF_CHECK_COMMIT_ERROR:-ledger_write_failed}" kind why tail=" — not approved"

  case "${failure}" in
    core_missing) kind=core-missing why="an approval is written with the safedeps-core binary, which is missing" ;;
    approvals_store_failed) kind=approvals-store why="the approvals store did not take the approval" ;;
    approvals_store_in_doubt)
      kind=approvals-store-in-doubt
      why="the approvals store may hold its line, and nothing confirms that its ledger entry stands"
      tail=" — in doubt"
      ;;
    *) kind=ledger-write why="the ledger entry or its advisory.log line could not be written" ;;
  esac
  sf_err "${package}@${version} cleared, but ${why}${tail}"
  sf_advisory_log "check fail-closed ${kind} ecosystem=${ecosystem} package=${package} version=${version}"
  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    sf_check_json "${SAFEDEPS_CHECK_ERROR}" "${ecosystem}" "${package}" "${range}" '{}' '{resolved_version:$version}' \
      '{approved:false, error:$error}' \
      -n --arg version "${version}" --arg error "${failure}"
  fi
}

# ---- the core and the approvals store ----------------------------------------

# The core binary beside this CLI, bin/native/<os>-<arch>/safedeps-core, into
# SF_CORE. The platform is read from bash the way the hook entry reads it
# (scripts/safedeps-hook-entry.sh), and nothing in the environment chooses the
# binary. The approvals store is the core's (rust/src/approvals.rs), so an
# approval is written with it and a cache hit is read with it, each time in the
# SAFEDEPS_HOME this CLI writes the ledger and advisory.log in. Where it is not
# there, SF_CORE_MISSING says where it was looked for.
SF_CORE=""
SF_CORE_MISSING=""
sf_core() {
  local machine="${BASH_VERSINFO[5]:-}" native="${SAFEDEPS_REPO_DIR}/bin/native" os="" arch="" repair

  if [[ -d "${SAFEDEPS_REPO_DIR}/rust" ]]; then
    repair="build it from this checkout with ${SAFEDEPS_REPO_DIR}/scripts/build-core.sh"
  else
    repair="reinstall the package"
  fi
  case "${machine}" in
    *-darwin*) os=darwin ;;
    *-linux*) os=linux ;;
  esac
  case "${machine%%-*}" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=x64 ;;
  esac
  if [[ -z "${os}" || -z "${arch}" ]]; then
    SF_CORE_MISSING="no safedeps-core binary is built for this machine (bash was built for ${machine:-an unnamed machine}), so none was found under ${native}"
    return 1
  fi
  SF_CORE="${native}/${os}-${arch}/safedeps-core"
  if [[ ! -f "${SF_CORE}" || ! -x "${SF_CORE}" ]]; then
    SF_CORE_MISSING="the safedeps-core binary is missing: ${SF_CORE} is not an executable file. Repair: ${repair}"
    return 1
  fi
}

# What `safedeps-core approvals index` prints, as jq: an object whose `present`
# is a boolean, `hashes` an object keyed by hash and `broken` a number
# (index_json in rust/src/approvals.rs). Anything else is no index, and no
# reader takes it for a store that vouches for nothing.
SF_APPROVALS_INDEX_JQ='def approvals_index_whole:
  type == "object" and (.present | type) == "boolean" and (.hashes | type) == "object" and (.broken | type) == "number";'

# Whether the approvals store vouches for HASH, from one read of the store:
# 0 it does, 1 it does not, 2 it could not be read (no core, a store the core
# could not read, or an answer that is no index).
sf_store_vouches() {
  local hash="$1" index answer

  sf_core || return 2
  index=$(SAFEDEPS_HOME="${SAFEDEPS_HOME}" "${SF_CORE}" approvals index) || return 2
  answer=$(jq -r --arg hash "${hash}" "${SF_APPROVALS_INDEX_JQ}"'
    if approvals_index_whole
    then (if .hashes[$hash] == true then "vouched" else "not vouched" end)
    else error("not an approvals index") end' <<< "${index}") || return 2
  case "${answer}" in
    vouched) return 0 ;;
    "not vouched") return 1 ;;
  esac
  return 2
}

# An approval is three records and a report. The ledger entry is what the hook
# reads, the `check approve(...)` line in advisory.log is the record a person
# reads, and the line in the approvals store is the record re-check and the
# cache lookup read. This CLI makes the entry and validates it in a staged file
# beside the entry's path (safedeps_ledger_stage). The core commits it
# (`safedeps-core approvals commit`, rust/src/approvals.rs), all under the
# store lock and in this order: it removes an entry at the path that the store
# does not vouch for, writes the store line and syncs it, writes the approve
# line, then renames the staged file into place. The rename is the commit
# point, and the first step that fails stops the commit. So a failed check
# leaves no entry of its own, and at most a store line with no entry. The core
# never removes the staged file: this function does. The binary is found
# before anything is staged, so a missing one leaves nothing (core-missing).
# The caller makes the report first, calls this, and only prints after it.
#
# The commit answers `approved`, or `not-approved <failure> <entry>`: the
# failure for the report, and whether the commit removed an entry the store
# did not vouch for. What the core cannot rule out it names on stderr and in
# advisory.log: unsynced (rust/src/approvals.rs). A commit that answered
# neither ended before it answered. MINE, a second name for the staged file
# made before the commit starts, says where the commit left this check's file:
#   - at the staged path: the commit put no entry in place, and the store may
#     hold its line, so the check is in doubt;
#   - at the entry's path: the commit renamed it into place, its commit point,
#     so the approval stands;
#   - at neither: nothing says more, so the check is in doubt and says only
#     that.
# MINE is removed on every path. Rotation of advisory.log is not work for the
# store lock, so it runs before the commit.
# SF_CHECK_COMMIT_ERROR names a failure for the report. A report names no
# entry: whatever stands at the path after a failed check is not its own.
#   sf_check_commit HASH ENTRY RECORD
SF_CHECK_COMMIT_ERROR=""
sf_check_commit() {
  local hash="$1" entry="$2" record="$3"
  local ledger_file staged mine="" answer rc=0 ended

  SF_CHECK_COMMIT_ERROR="ledger_write_failed"
  if ! sf_core; then
    SF_CHECK_COMMIT_ERROR="core_missing"
    sf_eprintf "safedeps: core-missing: ${SF_CORE_MISSING}. An approval is written with it, so nothing is approved."
    return 1
  fi
  ledger_file=$(safedeps_ledger_path_for_hash "${hash}") || return 1
  staged=$(safedeps_ledger_stage "${ledger_file}" <<< "${entry}") || return 1
  if ! mine=$(mktemp "${ledger_file%/*}/.${ledger_file##*/}.mine.XXXXXX") || ! ln -f -- "${staged}" "${mine}" 2>/dev/null; then
    rm -f -- "${staged}" ${mine:+"${mine}"} || true
    sf_eprintf "safedeps: not committed: the staged entry of ${hash} could not be given a second name, so the commit was not started."
    return 1
  fi
  safedeps_advisory_log_rotate_once
  answer=$(SAFEDEPS_HOME="${SAFEDEPS_HOME}" "${SF_CORE}" approvals commit "${hash}" "${staged}" "${ledger_file}" <<< "${record}") || rc=$?
  if [[ "${rc}" -eq 0 && "${answer}" == approved ]]; then
    rm -f -- "${mine}" || true
    return 0
  fi
  if [[ "${rc}" -eq 1 ]] && sf_check_commit_answer "${answer}"; then
    sf_check_commit_drop "${staged}" "${mine}"
    return 1
  fi
  if [[ "${rc}" -gt 128 ]]; then ended="signal-$((rc - 128))"; else ended="exit-${rc}"; fi
  if [[ "${staged}" -ef "${mine}" ]]; then
    sf_check_commit_drop "${staged}" "${mine}"
    SF_CHECK_COMMIT_ERROR="approvals_store_in_doubt"
    sf_eprintf "safedeps: in-doubt: the commit of ${hash} ended with ${ended} before it answered. Its staged entry is still there, so it put no entry in place. The approvals store may hold its line, and advisory.log its approve line."
    return 1
  fi
  if [[ "${ledger_file}" -ef "${mine}" ]]; then
    rm -f -- "${mine}" || true
    sf_eprintf "safedeps: the commit of ${hash} ended with ${ended} before it answered. Its entry is at the ledger entry's path, so the approval stands."
    return 0
  fi
  rm -f -- "${mine}" || true
  SF_CHECK_COMMIT_ERROR="approvals_store_in_doubt"
  sf_eprintf "safedeps: in-doubt: the commit of ${hash} ended with ${ended} before it answered. This check's file is neither at the staged path nor at the entry's path."
  return 1
}

# A commit's files once it answered: the staged file, where it is still this
# check's (MINE), then MINE.
sf_check_commit_drop() {
  local staged="$1" mine="$2"

  if [[ "${staged}" -ef "${mine}" ]]; then
    rm -f -- "${staged}" || true
  fi
  rm -f -- "${mine}" || true
}

# A commit's `not-approved <failure> <entry>`, read into SF_CHECK_COMMIT_ERROR.
# Anything else is no answer, and nothing is read.
sf_check_commit_answer() {
  local failure entry

  [[ "$1" == "not-approved "* ]] || return 1
  failure=${1#not-approved }
  entry=${failure#* }
  failure=${failure%% *}
  case "${failure}" in
    ledger_write_failed|approvals_store_failed|approvals_store_in_doubt) ;;
    *) return 1 ;;
  esac
  case "${entry}" in
    untouched|removed) ;;
    *) return 1 ;;
  esac
  SF_CHECK_COMMIT_ERROR="${failure}"
}

# The closure source as an approval's project context, or nothing when the
# closure scopes nothing. A type that does not read is a failure and not the
# second case, which would approve one project's closure for every project.
sf_approval_context() {
  local source_file="$1"
  local source_type

  source_type=$(jq -r '.type' "${source_file}") || return 1
  if safedeps_context_kind_scopes "${source_type}"; then printf '%s' "${source_file}"; fi
}

# The status of one provider answer, or nothing when the answer is not one value
# naming a status of the list. An unknown word and an empty one are the same
# nothing, so a caller's test for a status is its whole test.
sf_provider_status() {
  local status

  status=$(jq -rs "${SAFEDEPS_STATUS_JQ}"'if length == 1 then .[0].status | select(status_known) else empty end' <<< "$1" 2>/dev/null) || return 0
  printf '%s\n' "${status}"
}

sf_closure_temp_file() {
  local tmp_dir="${TMPDIR:-/tmp}"

  mkdir -p "${tmp_dir}"
  mktemp "${tmp_dir%/}/safedeps-closure.XXXXXX"
}

sf_npm_closure_for_spec() {
  local package_name="$1"
  local version="$2"
  local closure_file="$3"
  local source_file="$4"

  if ! safedeps_npm_resolve_spec_closure "${package_name}" "${version}" "${source_file}" > "${closure_file}"; then
    sf_eprintf "safedeps: npm closure resolution failed for ${package_name}@${version}"
    return 1
  fi

  jq -e 'type == "array" and length > 0' "${closure_file}" >/dev/null || {
    sf_eprintf "safedeps: npm closure is empty for ${package_name}@${version}"
    return 1
  }
}

sf_npm_batch_check_closure() {
  local closure_file="$1"
  local batch_file="$2"

  if ! safedeps_providers_query_batch "npm" "${closure_file}" > "${batch_file}"; then
    return 1
  fi
  # One answer per package of the closure, each a status of the list. Everything
  # after this counts what is bad, so a package that is missing here, or under a
  # word no count looks for, would read as clean.
  jq -e --slurpfile closure "${closure_file}" "${SAFEDEPS_STATUS_JQ}"'
    type == "array" and length == ($closure[0] | length) and all(.[]; .status | status_known)
  ' "${batch_file}" >/dev/null 2>&1
}

sf_npm_transitive_file_from_closure() {
  local closure_file="$1"
  local package_name="$2"
  local version="$3"
  local output_file="$4"

  jq -c --arg package "${package_name}" --arg version "${version}" '
    [
      .[]
      | select(.package != $package or (.version | tostring) != $version)
      | {ecosystem: "npm", package: .package, version: (.version | tostring)}
    ]
    | unique_by(.ecosystem + "\u0000" + .package + "\u0000" + .version)
    | sort_by(.package, .version)
  ' "${closure_file}" > "${output_file}"
}

sf_npm_evidence_file() {
  local provider_file="$1"
  local closure_file="$2"
  local source_file="$3"
  local output_file="$4"

  jq -cn \
    --slurpfile provider "${provider_file}" \
    --slurpfile closure "${closure_file}" \
    --slurpfile source "${source_file}" \
    '{
      closure_checked: true,
      closure_checked_at: (now | todateiso8601),
      closure_source: $source[0],
      provider: {type: "osv-querybatch", results: $provider[0]},
      closure: $closure[0]
    }' > "${output_file}"
}

sf_ledger_hit_has_npm_closure() {
  local ledger_check="$1"

  jq -e '.approved == true and (.spec.evidence.closure_checked == true)' <<< "${ledger_check}" >/dev/null 2>&1
}

sf_npm_emit_closure_block_json() {
  local result="$1"
  local ecosystem="$2"
  local package_name="$3"
  local range="$4"
  local version="$5"
  local batch_file="$6"
  local closure_file="$7"
  local source_file="$8"

  sf_check_json "${result}" "${ecosystem}" "${package_name}" "${range}" '{}' '{resolved_version:$version}' '{
      approved:false,
      closure_source: $source[0],
      resolved_closure: $closure[0],
      closure_vulnerabilities: [
        .[]
        | select(.status | status_risky)
        | {
            package: .package,
            version: .version,
            direct: (.direct // false),
            result: .status,
            vulnerabilities: (.vulnerabilities // []),
            kev: (.kev // {})
          }
      ]
    }' \
    --arg version "${version}" \
    --slurpfile closure "${closure_file}" \
    --slurpfile source "${source_file}" \
    "${batch_file}"
}

sf_cmd_check_npm_full_closure() {
  local ecosystem="$1"
  local pkg="$2"
  local range="$3"
  local version="$4"
  local closure_file
  local batch_file
  local evidence_file
  local transitive_file
  local source_file
  local direct_status
  local vulnerable_count
  local kev_count

  closure_file=$(sf_closure_temp_file)
  batch_file=$(sf_closure_temp_file)
  evidence_file=$(sf_mktemp_evidence)
  transitive_file=$(sf_closure_temp_file)
  source_file=$(sf_mktemp_evidence)
  local check_files=("${closure_file}" "${batch_file}" "${evidence_file}" "${transitive_file}" "${source_file}")

  sf_spinner_start "resolving npm closure (${pkg}@${version})"
  if ! sf_npm_closure_for_spec "${pkg}" "${version}" "${closure_file}" "${source_file}"; then
    local closure_source_json="null"
    sf_spinner_stop
    if [[ -s "${source_file}" ]]; then
      closure_source_json=$(cat "${source_file}")
    fi
    rm -f "${check_files[@]}"
    if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
      sf_check_json "${SAFEDEPS_CHECK_ERROR}" "${ecosystem}" "${pkg}" "${range}" '{}' '{resolved_version:$version}' \
        '{approved:false, error:(if ($closure_source | source_resolution_status?) then ($closure_source | source_resolution_status) else "npm_closure_resolution_failed" end), closure_source:$closure_source}' \
        -n --arg version "${version}" --argjson closure_source "${closure_source_json}"
    fi
    return 4
  fi
  sf_spinner_stop

  sf_spinner_start "batch-checking closure for advisories (OSV / KEV)"
  if ! sf_npm_batch_check_closure "${closure_file}" "${batch_file}"; then
    sf_spinner_stop
    rm -f "${check_files[@]}"
    sf_check_unavailable "${ecosystem}" "${pkg}" "${range}" "${version}" "${SF_UNAVAILABLE_BATCH}"
    return 4
  fi
  sf_spinner_stop

  if ! vulnerable_count=$(jq "${SAFEDEPS_STATUS_JQ}"'[.[] | select(.status == status_vulnerable)] | length' "${batch_file}") \
    || ! kev_count=$(jq "${SAFEDEPS_STATUS_JQ}"'[.[] | select(.status == status_hard_block)] | length' "${batch_file}") \
    || ! direct_status=$(jq -r --arg package "${pkg}" --arg version "${version}" '
      map(select(.package == $package and .version == $version)) | .[0].status // "missing"
    ' "${batch_file}"); then
    rm -f "${check_files[@]}"
    sf_check_unavailable "${ecosystem}" "${pkg}" "${range}" "${version}" "${SF_UNAVAILABLE_BATCH}"
    return 4
  fi

  if [[ "${kev_count}" -gt 0 ]]; then
    local kev_summary
    kev_summary=$(jq -r "${SAFEDEPS_STATUS_JQ}"'[.[] | select(.status == status_hard_block) | "\(.package)@\(.version)" + (if .direct then " (direct)" else " (transitive)" end)] | join(", ")' "${batch_file}")
    sf_err "KEV-matched package in closure — install blocked: ${kev_summary}"
    sf_advisory_log "check block(KEV closure) package=${pkg} version=${version} affected=${kev_summary}"
    if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
      sf_npm_emit_closure_block_json "${SAFEDEPS_CHECK_KEV_HARD_BLOCK}" "${ecosystem}" "${pkg}" "${range}" "${version}" "${batch_file}" "${closure_file}" "${source_file}"
    fi
    rm -f "${check_files[@]}"
    return 3
  fi

  if [[ "${vulnerable_count}" -gt 0 ]]; then
    local block_result="${SAFEDEPS_CHECK_CLOSURE_VULNERABLE}"
    if [[ "${direct_status}" == "${SAFEDEPS_STATUS_VULNERABLE}" ]]; then
      local direct_json
      local direct_evidence
      local candidate_closure
      local candidate_batch
      local candidate_source
      local patched_versions=()
      local patched_version
      direct_evidence=$(sf_mktemp_evidence)
      # A candidate is judged in files of its own. What is reported when none
      # is approved is the requested version, so its closure and its answer stay
      # as they were read.
      candidate_closure=$(sf_closure_temp_file)
      candidate_batch=$(sf_closure_temp_file)
      candidate_source=$(sf_mktemp_evidence)
      check_files+=("${direct_evidence}" "${candidate_closure}" "${candidate_batch}" "${candidate_source}")
      if ! direct_json=$(safedeps_providers_query "${ecosystem}" "${pkg}" "${version}") \
        || [[ -z "$(sf_provider_status "${direct_json}")" ]]; then
        rm -f "${check_files[@]}"
        sf_check_unavailable "${ecosystem}" "${pkg}" "${range}" "${version}" "${SF_UNAVAILABLE_PRIMARY}"
        return 4
      fi
      printf '%s' "${direct_json}" > "${direct_evidence}"
      while IFS= read -r patched_version; do
        [[ -z "${patched_version}" ]] && continue
        patched_versions+=("${patched_version}")
      done < <(sf_extract_patched_versions "${direct_evidence}" "${version}" || true)

      for patched_version in "${patched_versions[@]+${patched_versions[@]}}"; do
        sf_warn "${pkg}@${version} direct vulnerable — re-checking closure for candidate ${patched_version}."
        if ! sf_npm_closure_for_spec "${pkg}" "${patched_version}" "${candidate_closure}" "${candidate_source}"; then
          continue
        fi
        if ! sf_npm_batch_check_closure "${candidate_closure}" "${candidate_batch}" \
          || ! vulnerable_count=$(jq "${SAFEDEPS_STATUS_JQ}"'[.[] | select(.status | status_risky)] | length' "${candidate_batch}"); then
          rm -f "${check_files[@]}"
          sf_check_unavailable "${ecosystem}" "${pkg}" "${range}" "${version}" "${SF_UNAVAILABLE_BATCH}" "${patched_version}"
          return 4
        fi
        if [[ "${vulnerable_count}" -ne 0 ]]; then
          continue
        fi

        sf_npm_transitive_file_from_closure "${candidate_closure}" "${pkg}" "${patched_version}" "${transitive_file}"
        if safedeps_npm_source_is_deny_only "${candidate_source}"; then
          continue
        fi
        sf_npm_evidence_file "${candidate_batch}" "${candidate_closure}" "${candidate_source}" "${evidence_file}"
        local spec_json hash expires_at transitive_count closure_source_json resolved_closure_json report
        local project_context_arg
        if ! project_context_arg=$(sf_approval_context "${candidate_source}") \
          || ! spec_json=$(safedeps_ledger_render_approved_spec "${ecosystem}" "${pkg}" "${patched_version}" "${patched_version}" "safedeps-cli" "${evidence_file}" "${SAFEDEPS_LEDGER_DEFAULT_TTL_DAYS}" "${transitive_file}" "${project_context_arg}") \
          || ! hash=$(jq -r '.hash' <<< "${spec_json}") \
          || ! expires_at=$(jq -r '.expires_at' <<< "${spec_json}") \
          || ! transitive_count=$(jq 'length' "${transitive_file}") \
          || ! closure_source_json=$(cat "${candidate_source}") \
          || ! resolved_closure_json=$(cat "${candidate_closure}") \
          || ! report=$(sf_check_render "${SAFEDEPS_CHECK_PATCHED_AVAILABLE}" "${ecosystem}" "${pkg}" "${range}" '{}' '{resolved_version:$version, suggested_spec:$patched}' \
            '{approved:true, spec_hash:$hash, expires_at:$expires_at, transitive_count:$transitive_count, closure_source:$closure_source, resolved_closure:$resolved_closure, install_hint:install_hint($patched)}' \
            -n --arg version "${version}" \
            --arg patched "${patched_version}" \
            --arg hash "${hash}" --arg expires_at "${expires_at}" \
            --argjson transitive_count "${transitive_count}" \
            --argjson closure_source "${closure_source_json}" \
            --argjson resolved_closure "${resolved_closure_json}") \
          || ! sf_check_commit "${hash}" "${spec_json}" "check approve(patched closure) package=${pkg} version=${patched_version} hash=${hash} transitive=${transitive_count} prev_version=${version}"; then
          rm -f "${check_files[@]}"
          sf_check_not_written "${ecosystem}" "${pkg}" "${range}" "${patched_version}"
          return 4
        fi
        rm -f "${check_files[@]}" || true
        sf_ok "${pkg}@${patched_version} full closure cleared (transitive ${transitive_count}, until ${expires_at})"
        sf_info "ledger: ${hash}"
        sf_check_say "${report}"
        return 0
      done
      block_result="${SAFEDEPS_CHECK_CVE_UNPATCHED}"
    fi

    local affected_summary
    affected_summary=$(jq -r "${SAFEDEPS_STATUS_JQ}"'[.[] | select(.status == status_vulnerable) | "\(.package)@\(.version)" + (if .direct then " (direct)" else " (transitive)" end)] | join(", ")' "${batch_file}")
    sf_warn "vulnerable package in closure — approval withheld: ${affected_summary}"
    sf_advisory_log "check block(vulnerable closure) package=${pkg} version=${version} affected=${affected_summary}"
    if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
      sf_npm_emit_closure_block_json "${block_result}" "${ecosystem}" "${pkg}" "${range}" "${version}" "${batch_file}" "${closure_file}" "${source_file}"
    fi
    rm -f "${check_files[@]}"
    return 2
  fi

  if safedeps_npm_source_is_deny_only "${source_file}"; then
    local resolution_status
    resolution_status=$(jq -r "${SAFEDEPS_NPM_SOURCE_JQ}"'source_resolution_status // "closure_source_unreadable"' "${source_file}")
    sf_err "Yarn project closure is unavailable (${resolution_status}) — approval withheld"
    sf_advisory_log "check fail-closed yarn-project-closure package=${pkg} version=${version} reason=${resolution_status}"
    if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
      sf_check_json "${SAFEDEPS_CHECK_ERROR}" "${ecosystem}" "${pkg}" "${range}" '{}' '{resolved_version:$version}' \
        '{approved:false, error:$error, closure_source:$source[0], resolved_closure:$closure[0]}' \
        -n --arg version "${version}" \
        --arg error "${resolution_status}" \
        --slurpfile source "${source_file}" --slurpfile closure "${closure_file}"
    fi
    rm -f "${check_files[@]}"
    return 4
  fi

  sf_npm_transitive_file_from_closure "${closure_file}" "${pkg}" "${version}" "${transitive_file}"
  sf_npm_evidence_file "${batch_file}" "${closure_file}" "${source_file}" "${evidence_file}"
  local spec_json hash expires_at transitive_count closure_source_json resolved_closure_json report
  local project_context_arg
  if ! project_context_arg=$(sf_approval_context "${source_file}") \
    || ! spec_json=$(safedeps_ledger_render_approved_spec "${ecosystem}" "${pkg}" "${version}" "${range:-${version}}" "safedeps-cli" "${evidence_file}" "${SAFEDEPS_LEDGER_DEFAULT_TTL_DAYS}" "${transitive_file}" "${project_context_arg}") \
    || ! hash=$(jq -r '.hash' <<< "${spec_json}") \
    || ! expires_at=$(jq -r '.expires_at' <<< "${spec_json}") \
    || ! transitive_count=$(jq 'length' "${transitive_file}") \
    || ! closure_source_json=$(cat "${source_file}") \
    || ! resolved_closure_json=$(cat "${closure_file}") \
    || ! report=$(sf_check_render "${SAFEDEPS_CHECK_CLEAN}" "${ecosystem}" "${pkg}" "${range}" '{}' '{resolved_version:$version}' \
      '{approved:true, spec_hash:$hash, expires_at:$expires_at, transitive_count:$transitive_count, closure_source:$closure_source, resolved_closure:$resolved_closure, install_hint:install_hint($version)}' \
      -n --arg version "${version}" \
      --arg hash "${hash}" --arg expires_at "${expires_at}" \
      --argjson transitive_count "${transitive_count}" \
      --argjson closure_source "${closure_source_json}" \
      --argjson resolved_closure "${resolved_closure_json}") \
    || ! sf_check_commit "${hash}" "${spec_json}" "check approve(${SAFEDEPS_STATUS_CLEAN} closure) package=${pkg} version=${version} hash=${hash} transitive=${transitive_count}"; then
    rm -f "${check_files[@]}"
    sf_check_not_written "${ecosystem}" "${pkg}" "${range}" "${version}"
    return 4
  fi
  rm -f "${check_files[@]}" || true
  sf_ok "${pkg}@${version} full closure cleared (transitive ${transitive_count}, until ${expires_at})"
  sf_info "ledger: ${hash}"
  sf_check_say "${report}"
  return 0
}

# ---- check -------------------------------------------------------------------

cmd_check() {
  local ecosystem="" pkg_spec=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) cmd_help check; return 0 ;;
      --) shift; break ;;
      -*) sf_eprintf "safedeps: unknown option for check: $1"; return 4 ;;
      *)
        if [[ -z "${ecosystem}" ]]; then ecosystem="$1"
        elif [[ -z "${pkg_spec}" ]]; then pkg_spec="$1"
        else sf_eprintf "safedeps: unexpected arg: $1"; return 4
        fi
        shift; continue
        ;;
    esac
    shift
  done

  if [[ -z "${ecosystem}" || -z "${pkg_spec}" ]]; then
    sf_eprintf "usage: safedeps check <ecosystem> <pkg>@<version|range> [--json]"
    return 4
  fi

  sf_require_jq

  local pkg range
  pkg=$(sf_parse_pkg_spec "${pkg_spec}" | sed -n '1p')
  range=$(sf_parse_pkg_spec "${pkg_spec}" | sed -n '2p')

  local version
  sf_spinner_start "resolving version (${pkg}@${range})"
  if ! version=$(sf_resolve_version "${ecosystem}" "${pkg}" "${range}"); then
    sf_spinner_stop
    sf_err "version resolution failed: ${pkg}@${range}"
    if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
      sf_check_json "${SAFEDEPS_CHECK_ERROR}" "${ecosystem}" "${pkg}" "${range}" '{}' '{}' '{error:"version_resolution_failed"}' -n
    fi
    return 4
  fi
  sf_spinner_stop

  # Ledger lookup short-circuit
  local ledger_check
  local ledger_context_hash=""
  local ledger_context_file
  local ledger_context_status=1
  ledger_context_file=$(sf_mktemp_evidence)
  if [[ "${ecosystem}" == "npm" ]]; then
    if safedeps_npm_yarn_project_context "${ledger_context_file}"; then
      ledger_context_status=0
      ledger_context_hash=$(jq -r '.context_hash' "${ledger_context_file}")
    else
      ledger_context_status=$?
      # No Yarn context. An overrides-derived approval is stored under the hash
      # of the override set that produced it, so the cache lookup has to derive
      # the same hash or it would re-resolve a closure it already approved.
      if [[ "${ledger_context_status}" -ne 2 ]]; then
        local ov_src_file ov_json ov_src ov_status=2
        ov_src_file=$(sf_mktemp_evidence)
        if ov_json=$(safedeps_npm_repo_overrides_json "${ov_src_file}") && ov_src=$(cat "${ov_src_file}" 2>/dev/null); then
          ov_status=0
          safedeps_npm_overrides_context "${ledger_context_file}" "${ov_json}" "${ov_src}" || ov_status=$?
        fi
        rm -f "${ov_src_file}"
        # No overrides is the global key. Overrides with no context are no key at
        # all: the lookup is skipped, and the closure check answers for them.
        case "${ov_status}" in
          0) ledger_context_hash=$(jq -r '.context_hash' "${ledger_context_file}") ;;
          2) ledger_context_status=2 ;;
        esac
      fi
    fi
  fi
  # A cache hit is an approval the approvals store vouches for: a ledger entry
  # whose hash matches its fields is not enough on its own. The store is read
  # first and the entry after. A commit writes its store line only after it
  # removed an entry the store did not vouch for, so an entry read after the
  # store vouched for its hash is one the store vouched for then, or the
  # commit's own. In the other order the lookup could take for a hit an entry
  # a commit then removes, matched with the line of a commit that fails. Where
  # no file stands at the entry's path there is nothing to look up, and the
  # store is not read. An entry the store does not vouch for, or a store that
  # cannot be read, is checked again from the start, and a check that clears
  # it writes a new approval.
  local hash="" vouched=0 unvouched approved_at expires_at project_context resolved_closure
  if [[ "${ledger_context_status}" -ne 2 ]] \
    && hash=$(safedeps_ledger_hash "${ecosystem}" "${pkg}" "${version}" "${ledger_context_hash}") \
    && [[ -f "$(safedeps_ledger_path_for_hash "${hash}")" ]]; then
    sf_store_vouches "${hash}" || vouched=$?
    if ledger_check=$(safedeps_ledger_check "${ecosystem}" "${pkg}" "${version}" "${ledger_context_hash}" 2>/dev/null) \
      && [[ "$(jq -r '.hash' <<< "${ledger_check}" 2>/dev/null)" == "${hash}" ]] \
      && jq -e '.approved == true' <<< "${ledger_check}" >/dev/null 2>&1 \
      && { [[ "${ecosystem}" != "npm" ]] || sf_ledger_hit_has_npm_closure "${ledger_check}"; }; then
      if [[ "${vouched}" -ne 0 ]]; then
        unvouched="not-vouched"
        [[ "${vouched}" -eq 1 ]] || unvouched="unreadable"
        sf_warn "${pkg}@${version} is in the ledger, but the approvals store does not vouch for it (${unvouched}) — checking it again"
        sf_advisory_log "check ledger-unvouched ecosystem=${ecosystem} package=${pkg} version=${version} hash=${hash} store=${unvouched}"
      else
        approved_at=$(jq -r '.spec.approved_at // "n/a"' <<< "${ledger_check}")
        expires_at=$(jq -r '.spec.expires_at // "n/a"' <<< "${ledger_check}")
        project_context=$(jq -c '.spec.project_context // null' <<< "${ledger_check}")
        resolved_closure=$(jq -c '.spec.evidence.closure // []' <<< "${ledger_check}")
        sf_ok "${pkg}@${version} already approved (until ${expires_at})"
        sf_info "ledger: ${hash}"
        sf_advisory_log "check approve(cache) ecosystem=${ecosystem} package=${pkg} version=${version} hash=${hash}"
        if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
          sf_check_json "${SAFEDEPS_CHECK_ALREADY_APPROVED}" "${ecosystem}" "${pkg}" "${range}" '{}' '{resolved_version:$version}' \
            '{approved:true, spec_hash:$hash, approved_at:$approved_at, expires_at:$expires_at, closure_source:$project_context, resolved_closure:$resolved_closure, install_hint:install_hint($version)}' \
            -n --arg version "${version}" \
            --arg hash "${hash}" \
            --arg approved_at "${approved_at}" \
            --arg expires_at "${expires_at}" \
            --argjson project_context "${project_context}" \
            --argjson resolved_closure "${resolved_closure}"
        fi
        rm -f "${ledger_context_file}" || true
        return 0
      fi
    fi
  fi
  rm -f "${ledger_context_file}"

  if [[ "${ecosystem}" == "npm" ]]; then
    sf_cmd_check_npm_full_closure "${ecosystem}" "${pkg}" "${range}" "${version}"
    return $?
  fi

  # Provider query (canonical truth = OSV; KEV overlay; GHSA enrichment)
  local provider_json
  sf_spinner_start "checking advisories (OSV / KEV / GHSA)"
  if ! provider_json=$(safedeps_providers_query "${ecosystem}" "${pkg}" "${version}"); then
    sf_spinner_stop
    sf_check_unavailable "${ecosystem}" "${pkg}" "${range}" "${version}" "${SF_UNAVAILABLE_PRIMARY}"
    return 4
  fi
  sf_spinner_stop

  local tmp_evidence
  tmp_evidence=$(sf_mktemp_evidence)
  printf '%s' "${provider_json}" > "${tmp_evidence}"

  local status vuln_count
  status=$(sf_provider_status "${provider_json}")

  case "${status}" in
    "${SAFEDEPS_STATUS_HARD_BLOCK}")
      sf_err "KEV match — ${pkg}@${version} is exploited in the wild. install blocked."
      local kev_cves
      kev_cves=$(jq -r '[.kev.matches[]?.cveID] | unique | join(", ")' <<< "${provider_json}")
      [[ -n "${kev_cves}" ]] && sf_info "related CVEs: ${kev_cves}"
      sf_warn "consider an alternative package; this spec is not approved in the ledger."
      sf_advisory_log "check block(KEV) ecosystem=${ecosystem} package=${pkg} version=${version} cves=${kev_cves}"
      if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
        sf_check_json "${SAFEDEPS_CHECK_KEV_HARD_BLOCK}" "${ecosystem}" "${pkg}" "${range}" '.' '{resolved_version:$version}' '{approved:false}' \
          --arg version "${version}" <<< "${provider_json}"
      fi
      rm -f "${tmp_evidence}"
      return 3
      ;;

    "${SAFEDEPS_STATUS_VULNERABLE}")
      local patched_versions=()
      local patched_version
      vuln_count=$(jq -r '(.vulnerabilities // []) | length' <<< "${provider_json}")
      while IFS= read -r patched_version; do
        [[ -z "${patched_version}" ]] && continue
        patched_versions+=("${patched_version}")
      done < <(sf_extract_patched_versions "${tmp_evidence}" "${version}" || true)

      if [[ ${#patched_versions[@]} -gt 0 ]]; then
        local narrow_json=""
        local narrow_status=""
        local last_patched=""
        local last_status=""

        for patched_version in "${patched_versions[@]}"; do
          last_patched="${patched_version}"
          sf_warn "${pkg}@${version} has ${vuln_count} CVE(s) — re-checking candidate ${patched_version}."
          sf_spinner_start "re-checking ${patched_version}"
          if ! narrow_json=$(safedeps_providers_query "${ecosystem}" "${pkg}" "${patched_version}") \
            || ! narrow_status=$(sf_provider_status "${narrow_json}") || [[ -z "${narrow_status}" ]]; then
            sf_spinner_stop
            rm -f "${tmp_evidence}"
            sf_check_unavailable "${ecosystem}" "${pkg}" "${range}" "${version}" "${SF_UNAVAILABLE_PRIMARY}" "${patched_version}"
            return 4
          fi
          sf_spinner_stop

          last_status="${narrow_status}"
          if [[ "${narrow_status}" != "${SAFEDEPS_STATUS_CLEAN}" ]]; then
            sf_warn "patch candidate ${patched_version} is not clean either (status=${narrow_status}); trying the next candidate."
            continue
          fi

          # approve patched version
          local narrow_evidence
          narrow_evidence=$(sf_mktemp_evidence)
          printf '%s' "${narrow_json}" > "${narrow_evidence}"
          local narrow_range="${patched_version}"
          local spec_json hash expires_at report
          if ! spec_json=$(safedeps_ledger_render_approved_spec "${ecosystem}" "${pkg}" "${patched_version}" "${narrow_range}" "safedeps-cli" "${narrow_evidence}") \
            || ! hash=$(jq -r '.hash' <<< "${spec_json}") \
            || ! expires_at=$(jq -r '.expires_at' <<< "${spec_json}") \
            || ! report=$(sf_check_render "${SAFEDEPS_CHECK_PATCHED_AVAILABLE}" "${ecosystem}" "${pkg}" "${range}" '{}' '{resolved_version:$version, suggested_spec:$patched}' \
              '{approved:true, spec_hash:$hash, expires_at:$expires_at, install_hint:install_hint($patched)}' \
              -n --arg version "${version}" \
              --arg patched "${patched_version}" \
              --arg hash "${hash}" --arg expires_at "${expires_at}") \
            || ! sf_check_commit "${hash}" "${spec_json}" "check approve(patched) ecosystem=${ecosystem} package=${pkg} version=${patched_version} hash=${hash} prev_version=${version}"; then
            rm -f "${narrow_evidence}" "${tmp_evidence}"
            sf_check_not_written "${ecosystem}" "${pkg}" "${range}" "${patched_version}"
            return 4
          fi
          rm -f "${narrow_evidence}" "${tmp_evidence}" || true
          sf_ok "${pkg}@${patched_version} approved (until ${expires_at})"
          sf_info "ledger: ${hash}"
          sf_check_say "${report}"
          return 0
        done

        sf_err "re-checked all patch candidates but none are clean (last=${last_patched}, status=${last_status})"
        rm -f "${tmp_evidence}"
        if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
          sf_check_json "${SAFEDEPS_CHECK_PATCHED_STILL_VULNERABLE}" "${ecosystem}" "${pkg}" "${range}" '{}' '{resolved_version:$version, suggested_spec:$patched}' '{approved:false, patched_status:$status}' \
            -n --arg version "${version}" \
            --arg patched "${last_patched}" --arg status "${last_status}"
        fi
        return 2
      else
        sf_warn "${pkg}@${version} has ${vuln_count} CVE(s) — no patch available. approval withheld."
        sf_advisory_log "check warn(no-patch) ecosystem=${ecosystem} package=${pkg} version=${version} vulns=${vuln_count}"
        rm -f "${tmp_evidence}"
        if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
          sf_check_json "${SAFEDEPS_CHECK_CVE_UNPATCHED}" "${ecosystem}" "${pkg}" "${range}" '.' '{resolved_version:$version}' '{approved:false}' \
            --arg version "${version}" <<< "${provider_json}"
        fi
        return 2
      fi
      ;;

    "${SAFEDEPS_STATUS_CLEAN}")
      local spec_json hash expires_at report
      if ! spec_json=$(safedeps_ledger_render_approved_spec "${ecosystem}" "${pkg}" "${version}" "${range:-${version}}" "safedeps-cli" "${tmp_evidence}") \
        || ! hash=$(jq -r '.hash' <<< "${spec_json}") \
        || ! expires_at=$(jq -r '.expires_at' <<< "${spec_json}") \
        || ! report=$(sf_check_render "${SAFEDEPS_CHECK_CLEAN}" "${ecosystem}" "${pkg}" "${range}" '{}' '{resolved_version:$version}' \
          '{approved:true, spec_hash:$hash, expires_at:$expires_at, install_hint:install_hint($version)}' \
          -n --arg version "${version}" \
          --arg hash "${hash}" --arg expires_at "${expires_at}") \
        || ! sf_check_commit "${hash}" "${spec_json}" "check approve(${SAFEDEPS_STATUS_CLEAN}) ecosystem=${ecosystem} package=${pkg} version=${version} hash=${hash}"; then
        rm -f "${tmp_evidence}"
        sf_check_not_written "${ecosystem}" "${pkg}" "${range}" "${version}"
        return 4
      fi
      rm -f "${tmp_evidence}" || true
      sf_ok "${pkg}@${version} approved (until ${expires_at})"
      sf_info "ledger: ${hash}"
      sf_check_say "${report}"
      return 0
      ;;

    *)
      rm -f "${tmp_evidence}"
      sf_check_unavailable "${ecosystem}" "${pkg}" "${range}" "${version}" "${SF_UNAVAILABLE_PRIMARY}"
      return 4
      ;;
  esac
}

# ---- ledger ------------------------------------------------------------------

cmd_ledger() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) cmd_help ledger; return 0 ;;
      *) sf_eprintf "safedeps: unexpected arg for ledger: $1"; return 4 ;;
    esac
  done

  sf_require_jq
  safedeps_ledger_init

  if ! sf_ledger_files; then
    sf_ledger_unlisted "ledger"
    return 4
  fi
  local entries=("${SF_LEDGER_FILES[@]+${SF_LEDGER_FILES[@]}}")

  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    local merged='[]'
    for f in "${entries[@]+${entries[@]}}"; do
      merged=$(jq -c --slurpfile spec "${f}" --argjson now_epoch "$(date +%s)" "${SAFEDEPS_LEDGER_JQ_PREDICATE}"'
        . + [
          ($spec[0]) as $s |
          {
            hash: $s.hash,
            ecosystem: $s.ecosystem,
            package: $s.package,
            version: $s.version,
            version_range: $s.version_range,
            approved_at: $s.approved_at,
            expires_at: $s.expires_at,
            approved_by: $s.approved_by,
            expired: ($s | ledger_unexpired($now_epoch) | not),
            revoked: (($s.revoked_at // null) != null)
          }
        ]
      ' <<< "${merged}")
    done
    jq -nc --argjson specs "${merged}" '{command:"ledger", count: ($specs | length), specs: $specs}'
    return 0
  fi

  if [[ ${#entries[@]} -eq 0 ]]; then
    sf_info "approved-specs is empty (${SAFEDEPS_LEDGER_DIR})"
    return 0
  fi

  printf '%s%-8s %-12s %-40s %-14s %-22s %-22s %s%s\n' \
    "${C_BOLD}" "STATE" "ECOSYSTEM" "PACKAGE" "VERSION" "APPROVED" "EXPIRES" "HASH" "${C_RESET}"
  for f in "${entries[@]+${entries[@]}}"; do
    local hash ecosystem pkg version approved_at expires_at revoked_at expired state state_color
    hash=$(jq -r '.hash // ""' "${f}")
    ecosystem=$(jq -r '.ecosystem // ""' "${f}")
    pkg=$(jq -r '.package // ""' "${f}")
    version=$(jq -r '.version // ""' "${f}")
    approved_at=$(jq -r '.approved_at // ""' "${f}")
    expires_at=$(jq -r '.expires_at // ""' "${f}")
    revoked_at=$(jq -r '.revoked_at // ""' "${f}")

    expired=0
    safedeps_ledger_is_expired_file "${f}" && expired=1

    if [[ -n "${revoked_at}" ]]; then
      state="REVOKED"; state_color="${C_GRAY}"
    elif [[ "${expired}" -eq 1 ]]; then
      state="EXPIRED"; state_color="${C_YELLOW}"
    else
      state="ACTIVE";  state_color="${C_GREEN}"
    fi

    printf '%s%-8s%s %-12s %-40s %-14s %-22s %-22s %s\n' \
      "${state_color}" "${state}" "${C_RESET}" \
      "${ecosystem}" "${pkg}" "${version}" \
      "${approved_at}" "${expires_at}" "${hash}"
  done
}

# ---- revoke ------------------------------------------------------------------

# A revoke rewrites a ledger entry, so it runs under the approvals store lock,
# as a commit does. The ledger's format keeps one writer, this CLI, so the CLI
# makes the revoked entry and the core puts it in place, as with a commit. The
# CLI takes a second name for the entry at the path and reads that file once:
# what it validates is what it revokes. It stages the revoked entry beside the
# path. The core (`safedeps-core approvals revoke`, rust/src/approvals.rs)
# takes the lock and renames the staged entry into place only where the entry
# at the path is still the file the CLI read. Otherwise a commit replaced or
# removed the entry between the read and the lock: the core answers
# `changed`, and the revoke reads the entry again. Where no entry stands then,
# nothing is revoked, and the revoke says so. An entry that changes three
# times running is an error, and nothing is revoked. Prints the revoked entry.
#   sf_ledger_revoke ECOSYSTEM PACKAGE VERSION REASON CONTEXT_HASH
SF_REVOKE_READS=3
sf_ledger_revoke() {
  local ecosystem="$1" package="$2" version="$3" reason="$4" context_hash="$5"
  local ledger_file hash seen valid staged entry answer rc attempt

  if ! sf_core; then
    sf_eprintf "safedeps: core-missing: ${SF_CORE_MISSING}. A revoke is written with it, so nothing is revoked."
    return 1
  fi
  ledger_file=$(safedeps_ledger_path "${ecosystem}" "${package}" "${version}" "${context_hash}") || return 1
  hash=$(safedeps_ledger_hash "${ecosystem}" "${package}" "${version}" "${context_hash}") || return 1
  for (( attempt = 1; attempt <= SF_REVOKE_READS; attempt++ )); do
    if [[ ! -f "${ledger_file}" ]]; then
      sf_eprintf "safedeps: no ledger entry stands at ${ledger_file} now, so nothing was revoked."
      return 1
    fi
    seen=$(mktemp "${ledger_file%/*}/.${ledger_file##*/}.seen.XXXXXX") || return 1
    if ! ln -f "${ledger_file}" "${seen}" 2>/dev/null \
      || ! valid=$(safedeps_ledger_valid_entry "${seen}") \
      || ! entry=$(safedeps_ledger_render_revoked "${reason}" <<< "${valid}") \
      || ! staged=$(safedeps_ledger_stage "${ledger_file}" <<< "${entry}"); then
      rm -f -- "${seen}" || true
      return 1
    fi
    rc=0
    answer=$(SAFEDEPS_HOME="${SAFEDEPS_HOME}" "${SF_CORE}" approvals revoke "${hash}" "${staged}" "${ledger_file}" "${seen}") || rc=$?
    rm -f -- "${seen}" || true
    if [[ "${rc}" -eq 0 && "${answer}" == revoked ]]; then
      printf '%s\n' "${entry}"
      return 0
    fi
    rm -f -- "${staged}" || true
    [[ "${rc}" -eq 1 && "${answer}" == changed ]] || return 1
  done
  sf_eprintf "safedeps: the ledger entry ${ledger_file} changed ${SF_REVOKE_READS} times while revoke read it, so nothing was revoked."
  return 1
}

cmd_revoke() {
  local arg1="" arg2="" reason=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) cmd_help revoke; return 0 ;;
      --reason) reason="${2:-}"; shift 2; continue ;;
      --reason=*) reason="${1#--reason=}"; shift; continue ;;
      -*) sf_eprintf "safedeps: unknown option for revoke: $1"; return 4 ;;
      *)
        if [[ -z "${arg1}" ]]; then arg1="$1"
        elif [[ -z "${arg2}" ]]; then arg2="$1"
        else sf_eprintf "safedeps: unexpected arg: $1"; return 4
        fi
        shift; continue
        ;;
    esac
    shift
  done

  if [[ -z "${arg1}" ]]; then
    sf_eprintf "usage: safedeps revoke <hash> | <ecosystem> <pkg>@<version> | <pkg>@<version>  [--reason <reason>]"
    return 4
  fi

  sf_require_jq
  safedeps_ledger_init
  reason="${reason:-cli-revoke}"

  local target_file=""
  if [[ "${arg1}" == sha256:* ]]; then
    target_file=$(safedeps_ledger_path_for_hash "${arg1}")
    [[ -f "${target_file}" ]] || { sf_err "no ledger entry: ${arg1}"; return 1; }
  else
    # one or two args. Two = ecosystem + pkg@version. One = pkg@version (scan).
    if [[ -n "${arg2}" ]]; then
      local pkg version
      pkg=$(sf_parse_pkg_spec "${arg2}" | sed -n '1p')
      version=$(sf_parse_pkg_spec "${arg2}" | sed -n '2p')
      [[ -n "${version}" ]] || { sf_eprintf "safedeps: revoke needs pkg@version, got '${arg2}'"; return 4; }
      if ! sf_ledger_files; then
        sf_ledger_unlisted "revoke"
        return 4
      fi
      local matches=()
      for f in "${SF_LEDGER_FILES[@]+${SF_LEDGER_FILES[@]}}"; do
        local e p v
        e=$(jq -r '.ecosystem // ""' "${f}")
        p=$(jq -r '.package // ""' "${f}")
        v=$(jq -r '.version // ""' "${f}")
        if [[ "${e}" == "${arg1}" && "${p}" == "${pkg}" && "${v}" == "${version}" ]]; then
          matches+=("${f}")
        fi
      done
      case "${#matches[@]}" in
        0) sf_err "no ledger entry: ${arg1} ${pkg}@${version}"; return 1 ;;
        1) target_file="${matches[0]}" ;;
        *) sf_err "${arg1} ${pkg}@${version} matched multiple project contexts — revoke by hash"; return 4 ;;
      esac
    else
      local pkg version
      pkg=$(sf_parse_pkg_spec "${arg1}" | sed -n '1p')
      version=$(sf_parse_pkg_spec "${arg1}" | sed -n '2p')
      [[ -n "${version}" ]] || { sf_eprintf "safedeps: revoke needs pkg@version or hash, got '${arg1}'"; return 4; }
      if ! sf_ledger_files; then
        sf_ledger_unlisted "revoke"
        return 4
      fi
      local matches=()
      for f in "${SF_LEDGER_FILES[@]+${SF_LEDGER_FILES[@]}}"; do
        local p v
        p=$(jq -r '.package // ""' "${f}")
        v=$(jq -r '.version // ""' "${f}")
        if [[ "${p}" == "${pkg}" && "${v}" == "${version}" ]]; then
          matches+=("${f}")
        fi
      done
      case "${#matches[@]}" in
        0) sf_err "no ledger entry: ${pkg}@${version}"; return 1 ;;
        1) target_file="${matches[0]}" ;;
        *) sf_err "${pkg}@${version} matched multiple ecosystems or project contexts — revoke by hash"; return 4 ;;
      esac
    fi
  fi

  local ecosystem pkg version
  ecosystem=$(jq -r '.ecosystem' "${target_file}")
  pkg=$(jq -r '.package' "${target_file}")
  version=$(jq -r '.version' "${target_file}")
  local context_hash
  context_hash=$(jq -r "${SAFEDEPS_LEDGER_JQ_PREDICATE} ledger_context_hash" "${target_file}")

  local revoked_json
  revoked_json=$(sf_ledger_revoke "${ecosystem}" "${pkg}" "${version}" "${reason}" "${context_hash}")
  sf_advisory_log "revoke ecosystem=${ecosystem} package=${pkg} version=${version} reason=${reason}"
  sf_ok "revoked: ${ecosystem} ${pkg}@${version}"
  sf_info "reason: ${reason}"

  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    jq -c --arg reason "${reason}" \
      '{command:"revoke", revoked:true, reason:$reason, spec: .}' <<< "${revoked_json}"
  fi
}

# ---- watch -------------------------------------------------------------------

# The watch (lib/watch/watch.sh) is its own entry, as the release-time gates
# are: the CLI hands it the command and the two things it cannot read for
# itself, the version and the output mode. Nothing of it is sourced here, so
# the CLI files stay the set the core's tests read (rust/src/cli_text.rs).
cmd_watch() {
  case "${1:-}" in
    -h|--help) cmd_help watch; return 0 ;;
  esac
  SAFEDEPS_VERSION="${SAFEDEPS_VERSION}" SAFEDEPS_JSON_MODE="${SAFEDEPS_JSON_MODE}" \
    exec bash "${SAFEDEPS_REPO_DIR}/lib/watch/watch.sh" "$@"
}

# ---- re-check ----------------------------------------------------------------

# The provenance of a re-check: one read of the approvals store, made by the
# core (`safedeps-core approvals index`, rust/src/approvals.rs), into OUT:
# {present, hashes:{"sha256:<hex>":true}, broken}. A store line vouches for an
# entry by its hash alone, the hash recomputed from the entry's own fields: an
# ecosystem, a package and a version would vouch for an entry of another
# project context. advisory.log is not read. It is rotated and compacted, so
# what it holds is no record of which approvals were made. A store that is not
# there is an answer, `present: false`, and vouches for nothing.
# Returns 0, or 1 with SF_RECHECK_FAILURE naming what could not be read:
# core_missing (no core to read the store with; SF_CORE_MISSING says where it
# was looked for), or approvals_store_unreadable (a store the core could not
# read, or an answer that is no index). Neither is a store that vouches for
# nothing, or for everything.
SF_RECHECK_FAILURE=""
sf_recheck_provenance_index() {
  local out="$1"

  SF_RECHECK_FAILURE="core_missing"
  sf_core || return 1
  SF_RECHECK_FAILURE="approvals_store_unreadable"
  SAFEDEPS_HOME="${SAFEDEPS_HOME}" "${SF_CORE}" approvals index > "${out}" || return 1
  jq -se "${SF_APPROVALS_INDEX_JQ}"'length == 1 and (.[0] | approvals_index_whole)' "${out}" > /dev/null || return 1
  SF_RECHECK_FAILURE=""
}

# A re-check that could not read the approvals store judged no entry, and says
# which read failed: on stderr, as a fail-closed line in advisory.log, and in
# --json as `{command, error}` with no report. Exit 4, as for a ledger that
# could not be listed.
sf_recheck_unproven() {
  local failure="${SF_RECHECK_FAILURE}"

  if [[ "${failure}" == core_missing ]]; then
    sf_eprintf "safedeps: core-missing: ${SF_CORE_MISSING}. re-check reads the approvals store with it, so no entry was judged."
  else
    failure="approvals_store_unreadable"
    sf_eprintf "safedeps: approvals-store-unreadable: the approvals store in ${SAFEDEPS_HOME} could not be read, so no entry was judged."
  fi
  sf_advisory_log "re-check fail-closed ${failure//_/-}" || true
  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    jq -nc --arg error "${failure}" '{command:"re-check", error:$error}'
  fi
}

# The ledger stage of a re-check: every live ledger entry asked of the
# providers again, a vulnerable or KEV-listed one revoked. Prints the report
# (`recheck_report`) and returns 0, or 1 when the report carries errors[].
#
# One entry that cannot be read, answered or revoked is a row of errors[], and
# the run goes on to the next: a revoke that failed, a file that is not one
# ledger entry, a field that is not a string, a spec the providers gave no
# answer for. The report is printed whatever errors it holds, and only then
# does the stage say it failed. Before, one such entry ended the run under
# errexit with no report at all.
#
# A spec with no answer is neither still clean nor revoked, and errors[] is the
# one place that says so: `provider_unavailable`, one row per entry, beside a
# `re-check unanswered` line in advisory.log. It used to be skipped with a
# warning only, and an answer kept from an earlier run made it still clean.
#
# A spec several contexts approved is asked once, and the answer applies to
# each of its entries; the counts stay per entry.
SF_RECHECK_REPORT=""
sf_recheck_stage() {
  local work entries fields expected index listed groups f n=0 rc=0
  local errors_arr='[]'

  SF_RECHECK_REPORT=""
  safedeps_ledger_init
  if ! sf_ledger_files; then
    return 4
  fi
  work=$(safedeps_provider_mktemp_dir) || return 1
  entries="${work}/entries.jsonl"
  fields="${work}/fields.bin"
  expected="${work}/expected.jsonl"
  index="${work}/provenance.json"
  listed="${work}/listed.txt"
  groups="${work}/groups.bin"
  : > "${entries}"
  : > "${expected}"

  # 1. Each file, read once. A file that is not one entry with string fields is
  #    an error row, not the end of the run.
  for f in "${SF_LEDGER_FILES[@]+${SF_LEDGER_FILES[@]}}"; do
    if ! jq -cse --argjson i "${n}" --arg file "${f##*/}" "${SAFEDEPS_LEDGER_JQ_PREDICATE}"'
        select(length == 1) | .[0]
        | select(type == "object" and (.ecosystem | type) == "string" and (.package | type) == "string"
                 and ((.version | type) == "string" or (.version | type) == "number"))
        | {i: $i, file: $file, ecosystem, package, version: (.version | tostring),
           revoked_at: ((.revoked_at // "") | tostring), hash: ((.hash // "") | tostring),
           context_hash: (ledger_context_hash | tostring)}
        | . + {malformed: ([.ecosystem, .package, .version] | any(test("[\\x00-\\x1F\\x7F]")))}' \
        "${f}" >> "${entries}" 2>/dev/null; then
      errors_arr=$(jq -c --arg file "${f##*/}" '. + [{kind:"ledger_entry_unreadable", file:$file}]' <<< "${errors_arr}")
    fi
    n=$((n + 1))
  done

  # 2. The canonical hash of each live, well-formed entry, recomputed from its
  #    own fields: the stored one is writable by anyone who can write the file.
  if ! jq -j 'select(.revoked_at == "" and (.malformed | not))
        | [(.i | tostring), .ecosystem, .package, .version, .context_hash] | map(. + "\u0000") | add' "${entries}" > "${fields}"; then
    rm -rf "${work}"
    return 1
  fi
  local i eco pkg ver ctx h
  while IFS= read -r -d '' i && IFS= read -r -d '' eco && IFS= read -r -d '' pkg \
      && IFS= read -r -d '' ver && IFS= read -r -d '' ctx; do
    h=$(safedeps_ledger_hash "${eco}" "${pkg}" "${ver}" "${ctx}") || { rm -rf "${work}"; return 1; }
    printf '{"i":%s,"expected":"%s"}\n' "${i}" "${h}" >> "${expected}"
  done < "${fields}"

  # 3. Provenance for all of them from one read of the approvals store, made
  #    after the entries were read. A committed entry's store line is written
  #    before the entry is put in place, so an entry read first is never one
  #    whose line is still to come (rust/src/approvals.rs, "The readers"). A
  #    store that could not be read ends the run (5, SF_RECHECK_FAILURE).
  #    Then what the store says of itself: lines that vouch for nothing
  #    (broken), and hashes it vouches for where the listing has no file at
  #    the hash's path (unmatched: an approval whose commit did not finish, or
  #    one committed after the listing). A revoked entry still stands at its
  #    path. And the entries grouped by spec for the providers.
  if ! sf_recheck_provenance_index "${index}"; then
    rm -rf "${work}"
    return 5
  fi
  local base ledger_name_re='^sha256-[0-9a-f]{64}\.json$'
  if ! : > "${listed}"; then
    rm -rf "${work}"
    return 1
  fi
  for f in "${SF_LEDGER_FILES[@]+${SF_LEDGER_FILES[@]}}"; do
    base="${f##*/}"
    if [[ "${base}" =~ ${ledger_name_re} ]] && ! printf '%s\n' "${base}" >> "${listed}"; then
      rm -rf "${work}"
      return 1
    fi
  done
  local suspected_forgery_arr checked store_json store_counts
  if ! suspected_forgery_arr=$(jq -s -c --slurpfile expected "${expected}" --slurpfile index "${index}" '
        ($expected | map({key: (.i | tostring), value: .expected}) | from_entries) as $want
        | ($index[0].hashes) as $vouched
        | [.[] | select(.revoked_at == "")
           | (if .malformed then "malformed_spec"
              elif .hash != $want[(.i | tostring)] then "hash_spec_mismatch"
              elif $vouched[$want[(.i | tostring)]] == true then null
              else "unvouched" end) as $reason
           | select($reason != null)
           | {ecosystem, package, version, hash, reason: $reason}]' "${entries}") \
    || ! store_json=$(jq -c --rawfile listed "${listed}" '
        ($listed | split("\n") | map(select(length > 0) | {key: ., value: true}) | from_entries) as $files
        | {present, broken,
           unmatched: ([.hashes | keys[] | select($files["sha256-" + ltrimstr("sha256:") + ".json"] != true)] | length)}' "${index}") \
    || ! store_counts=$(jq -r '"\(.present) \(.broken) \(.unmatched)"' <<< "${store_json}") \
    || ! checked=$(jq -s '[.[] | select(.revoked_at == "")] | length' "${entries}") \
    || ! jq -s -j '[.[] | select(.revoked_at == "")]
        | group_by([.ecosystem, .package, .version])[]
        | [.[0].ecosystem, .[0].package, .[0].version, ([.[] | [.context_hash, .file]] | tojson)]
        | map(. + "\u0000") | add' "${entries}" > "${groups}"; then
    rm -rf "${work}"
    return 1
  fi
  local fg_count store_present store_broken store_unmatched
  read -r store_present store_broken store_unmatched <<< "${store_counts}"
  if [[ "${store_present}" != true && "${checked}" -gt 0 ]]; then
    sf_warn "  no approvals store in ${SAFEDEPS_HOME}: it vouches for no ledger entry"
  fi
  if [[ "${store_broken}" -gt 0 ]]; then
    if [[ "${store_broken}" -eq 1 ]]; then
      sf_warn "  1 line of the approvals store vouches for nothing (broken)"
    else
      sf_warn "  ${store_broken} lines of the approvals store vouch for nothing (broken)"
    fi
    sf_advisory_log "re-check approvals-store broken-lines=${store_broken}"
  fi
  if [[ "${store_unmatched}" -gt 0 ]]; then
    sf_info "  ${store_unmatched} approvals in the store have no ledger entry (unmatched)"
  fi
  fg_count=$(jq 'length' <<< "${suspected_forgery_arr}")
  if [[ "${fg_count}" -gt 0 ]]; then
    sf_warn "  ${fg_count} ledger entries have no provenance — flagged as suspected forgery (not revoked)"
  fi

  # 4. Each spec asked once.
  local still_clean=0
  local newly_vuln_arr='[]' kev_hit_arr='[]' revoked_arr='[]'
  local members count pj s reason ctx_hash file
  while IFS= read -r -d '' eco && IFS= read -r -d '' pkg && IFS= read -r -d '' ver && IFS= read -r -d '' members; do
    count=$(jq 'length' <<< "${members}")
    sf_info "re-checking ${eco} ${pkg}@${ver} (${count} entr$([[ "${count}" -eq 1 ]] && printf 'y' || printf 'ies'))"
    s=""
    if pj=$(safedeps_providers_query "${eco}" "${pkg}" "${ver}" 2>/dev/null); then
      s=$(sf_provider_status "${pj}")
    fi
    case "${s}" in
      "${SAFEDEPS_STATUS_CLEAN}")
        still_clean=$(( still_clean + count ))
        ;;
      "${SAFEDEPS_STATUS_VULNERABLE}"|"${SAFEDEPS_STATUS_HARD_BLOCK}")
        reason="re-check ${s}"
        while IFS=$'\x1f' read -r ctx_hash file; do
          if ! sf_ledger_revoke "${eco}" "${pkg}" "${ver}" "${reason}" "${ctx_hash}" >/dev/null 2>&1; then
            sf_err "  revoke failed: ${eco} ${pkg}@${ver} (${file})"
            errors_arr=$(jq -c --arg ecosystem "${eco}" --arg package "${pkg}" --arg version "${ver}" --arg file "${file}" \
              '. + [{kind:"revoke_failed", ecosystem:$ecosystem, package:$package, version:$version, file:$file}]' <<< "${errors_arr}")
            continue
          fi
          sf_advisory_log "re-check revoke ecosystem=${eco} package=${pkg} version=${ver} status=${s}"
          if [[ "${s}" == "${SAFEDEPS_STATUS_HARD_BLOCK}" ]]; then
            sf_err "  KEV match -> revoked"
            kev_hit_arr=$(jq -c --arg ecosystem "${eco}" --arg package "${pkg}" --arg version "${ver}" \
              "${SAFEDEPS_STATUS_JQ}"'. + [{ecosystem:$ecosystem, package:$package, version:$version, status:status_hard_block}]' <<< "${kev_hit_arr}")
          else
            sf_warn "  new CVE match -> revoked"
            newly_vuln_arr=$(jq -c --arg ecosystem "${eco}" --arg package "${pkg}" --arg version "${ver}" \
              "${SAFEDEPS_STATUS_JQ}"'. + [{ecosystem:$ecosystem, package:$package, version:$version, status:status_vulnerable}]' <<< "${newly_vuln_arr}")
          fi
          revoked_arr=$(jq -c --arg ecosystem "${eco}" --arg package "${pkg}" --arg version "${ver}" --arg reason "${reason}" \
            '. + [{ecosystem:$ecosystem, package:$package, version:$version, reason:$reason}]' <<< "${revoked_arr}")
        done < <(jq -r '.[] | .[0] + "\u001f" + .[1]' <<< "${members}")
        ;;
      *)
        sf_err "  no provider answer — neither still clean nor revoked"
        sf_advisory_log "re-check unanswered ecosystem=${eco} package=${pkg} version=${ver} entries=${count}"
        while IFS=$'\x1f' read -r ctx_hash file; do
          errors_arr=$(jq -c --arg kind "${SAFEDEPS_CHECK_PROVIDER_UNAVAILABLE}" --arg ecosystem "${eco}" --arg package "${pkg}" --arg version "${ver}" --arg file "${file}" \
            '. + [{kind:$kind, ecosystem:$ecosystem, package:$package, version:$version, file:$file}]' <<< "${errors_arr}")
        done < <(jq -r '.[] | .[0] + "\u001f" + .[1]' <<< "${members}")
        ;;
    esac
  done < "${groups}"
  rm -rf "${work}"

  SF_RECHECK_REPORT=$(jq -nc \
    --argjson newly_vulnerable "${newly_vuln_arr}" \
    --argjson kev_hit "${kev_hit_arr}" \
    --argjson revoked "${revoked_arr}" \
    --argjson suspected_forgery "${suspected_forgery_arr}" \
    --argjson errors "${errors_arr}" \
    --argjson checked "${checked}" \
    --argjson still_clean "${still_clean}" \
    --argjson approvals_store "${store_json}" \
    "${SAFEDEPS_RECHECK_REPORT_JQ}"'recheck_report($checked; $still_clean; $newly_vulnerable; $kev_hit; $revoked; $suspected_forgery; $errors; $approvals_store)') || return 1
  [[ "$(jq 'length' <<< "${errors_arr}")" -eq 0 ]] || rc=1
  return "${rc}"
}

cmd_recheck() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) cmd_help re-check; return 0 ;;
      *) sf_eprintf "safedeps: unexpected arg for re-check: $1"; return 4 ;;
    esac
  done

  sf_require_jq
  # A re-check runs under the watch lock, so two never revoke from one ledger at
  # once and a scan never reads one half done. lib/watch/watch.sh takes the
  # lock (or answers busy, exit 75) and runs this command again as its child,
  # naming itself in SAFEDEPS_WATCH_LOCK_HELD: a value that is not this
  # process's parent is not the lock.
  if [[ "${SAFEDEPS_WATCH_LOCK_HELD:-}" != "${PPID}" ]]; then
    SAFEDEPS_VERSION="${SAFEDEPS_VERSION}" SAFEDEPS_JSON_MODE="${SAFEDEPS_JSON_MODE}" \
      exec bash "${SAFEDEPS_REPO_DIR}/lib/watch/watch.sh" locked re-check
  fi
  local rc=0

  sf_recheck_stage || rc=$?
  if [[ "${rc}" -eq 4 ]]; then
    sf_ledger_unlisted "re-check"
    return 4
  fi
  if [[ "${rc}" -eq 5 ]]; then
    sf_recheck_unproven
    return 4
  fi
  if [[ -z "${SF_RECHECK_REPORT}" ]]; then
    sf_err "re-check could not finish"
    return "${rc:-1}"
  fi

  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    printf '%s\n' "${SF_RECHECK_REPORT}"
    return "${rc}"
  fi

  local checked still_clean nv kv fg er
  checked=$(jq -r "${SAFEDEPS_RECHECK_REPORT_JQ}"'recheck_checked' <<< "${SF_RECHECK_REPORT}")
  still_clean=$(jq -r "${SAFEDEPS_RECHECK_REPORT_JQ}"'recheck_still_clean' <<< "${SF_RECHECK_REPORT}")
  nv=$(jq -r "${SAFEDEPS_RECHECK_REPORT_JQ}"'recheck_newly_vulnerable | length' <<< "${SF_RECHECK_REPORT}")
  kv=$(jq -r "${SAFEDEPS_RECHECK_REPORT_JQ}"'recheck_kev_hit | length' <<< "${SF_RECHECK_REPORT}")
  fg=$(jq -r "${SAFEDEPS_RECHECK_REPORT_JQ}"'recheck_suspected_forgery | length' <<< "${SF_RECHECK_REPORT}")
  er=$(jq -r "${SAFEDEPS_RECHECK_REPORT_JQ}"'recheck_errors | length' <<< "${SF_RECHECK_REPORT}")
  sf_info "re-check complete: ${still_clean}/${checked} still clean"
  [[ "${nv}" -gt 0 ]] && sf_warn "revoked ${nv} for new CVE match"
  [[ "${kv}" -gt 0 ]] && sf_err  "revoked ${kv} for KEV match"
  [[ "${fg}" -gt 0 ]] && sf_warn "flagged ${fg} ledger entries with no approval provenance"
  [[ "${er}" -gt 0 ]] && sf_err "${er} ledger entries could not be read, answered or revoked (see --json errors)"
  return "${rc}"
}

# ---- migrate -----------------------------------------------------------------

cmd_migrate() {
  local keep_legacy=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep-legacy) keep_legacy=1; shift ;;
      -h|--help) cmd_help migrate; return 0 ;;
      *) sf_eprintf "safedeps: unexpected arg for migrate: $1"; return 4 ;;
    esac
  done

  if ! command -v node >/dev/null 2>&1; then
    sf_eprintf "safedeps: node is required for state migration"
    return 4
  fi

  local migrate_script="${SAFEDEPS_REPO_DIR}/scripts/install/migrate-safedeps-state.mjs"
  [[ -f "${migrate_script}" ]] || {
    sf_eprintf "safedeps: migration script not found: ${migrate_script}"
    return 4
  }

  if [[ "${keep_legacy}" -eq 1 ]]; then
    node "${migrate_script}" --keep-legacy
  else
    node "${migrate_script}"
  fi
}

# ---- release-time gates (absorbed from security-release-gates) ---------------

cmd_gates() {
  local script="${SAFEDEPS_REPO_DIR}/scripts/release-gates.sh"
  if [[ ! -f "${script}" ]]; then
    sf_eprintf "safedeps: release-gates script not found: ${script}"
    return 4
  fi
  # default subcommand is 'run'
  if [[ "${1:-}" == "run" ]]; then shift; fi
  exec bash "${script}" "$@"
}

cmd_scan() {
  exec bash "${SAFEDEPS_REPO_DIR}/lib/gates/scan.sh" "$@"
}

cmd_audit() {
  exec bash "${SAFEDEPS_REPO_DIR}/lib/gates/audit.sh" "$@"
}

cmd_hooks() {
  exec bash "${SAFEDEPS_REPO_DIR}/lib/gates/hooks.sh" "$@"
}

cmd_doctor() {
  exec env SAFEDEPS_JSON_MODE="${SAFEDEPS_JSON_MODE}" \
    bash "${SAFEDEPS_REPO_DIR}/lib/gates/doctor.sh" "$@"
}

# ---- approvals ---------------------------------------------------------------

# `safedeps approvals migrate [<archive>...]`: the approvals checks made before
# the approvals store, moved into it from advisory.log and the archives named.
# The migration is the core's (`safedeps-core approvals migrate`,
# rust/src/approvals/migrate.rs): it reads the inputs, judges each line and
# writes the store lines, under the store lock a commit holds and through a
# commit's write. This only calls it, in the SAFEDEPS_HOME and the ledger
# directory this CLI uses. It writes no advisory.log line, so it does not
# rotate advisory.log either.
cmd_approvals() {
  local core_args=()
  case "${1:-}" in
    migrate) shift ;;
    -h|--help) cmd_help approvals; return 0 ;;
    *) sf_eprintf "safedeps: approvals takes one subcommand, migrate [<archive>...]. Try 'safedeps help approvals'."; return 4 ;;
  esac
  if ! sf_core; then
    sf_eprintf "safedeps: core-missing: ${SF_CORE_MISSING}. The migration is the core's, so nothing was migrated."
    return 4
  fi
  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    core_args+=(--json)
  fi
  if ! SAFEDEPS_HOME="${SAFEDEPS_HOME}" SAFEDEPS_LEDGER_DIR="${SAFEDEPS_LEDGER_DIR}" \
    "${SF_CORE}" approvals migrate "${core_args[@]+"${core_args[@]}"}" "$@"; then
    return 4
  fi
}

# ---- help / version ----------------------------------------------------------

cmd_version() {
  if [[ "${SAFEDEPS_JSON_MODE}" -eq 1 ]]; then
    jq -nc --arg v "${SAFEDEPS_VERSION}" '{command:"version", version:$v}'
  else
    printf 'safedeps %s\n' "${SAFEDEPS_VERSION}"
  fi
}

cmd_help() {
  local topic="${1:-}"
  case "${topic}" in
    check)
      cat <<'EOF'
safedeps check <ecosystem> <pkg>@<version|range> [--json]

  Phase 1 advisory gate. Query OSV (canonical) + CISA KEV (overlay) + GHSA (enrichment),
  classify, and — when clean or patched_available — write an approved-spec entry.

  ecosystem: npm | pypi | crates.io | go | rubygems | maven | nuget
  exit codes: 0 clean/approved · 1 reserved · 2 cve_unpatched · 3 kev_hard_block · 4 input/provider error
EOF
      ;;
    ledger)
      cat <<'EOF'
safedeps ledger [--json]

  List approved specs from ~/.safedeps/approved-specs/.
  Columns: STATE ECOSYSTEM PACKAGE VERSION APPROVED EXPIRES HASH.
EOF
      ;;
    revoke)
      cat <<'EOF'
safedeps revoke <hash> | <ecosystem> <pkg>@<version> | <pkg>@<version> [--reason <reason>] [--json]

  Mark an approved-spec entry as revoked. The hook will then block install
  commands for that spec until it is re-approved with `safedeps check`.
EOF
      ;;
    re-check)
      cat <<'EOF'
safedeps re-check [--json]

  Re-query providers for every active approved spec, each spec once.
  Auto-revoke entries that newly match a CVE or KEV.
  An entry that cannot be read, answered or revoked is a row of `errors`,
  and the run goes on: the report is printed, then the command exits 1. An
  entry the providers gave no answer for (`provider_unavailable`) is neither
  still clean nor revoked. Every answer is asked of the providers by this run.
  It holds the watch lock (~/.safedeps/watch/lock); a second run exits 75.
EOF
      ;;
    watch)
      cat <<'EOF'
safedeps watch <scan|status|claim|claimed|ack|remediation|retire> [--json]

  scan [--root DIR]     The ledger re-check, then every registered project root
                        and the host's JDKs, measured again and merged into
                        ~/.safedeps/watch/state.json. Exit 0 published; 1
                        published with errors; 3 nothing published; 75 another
                        run holds the lock (retry later).
  status                Age of the last scan and last success, without the lock.
  claim --consumer ID [--limit N]
                        Take pending events; each stays claimed until acked.
  claimed --consumer ID Events this consumer holds.
  ack --event ID --consumer ID (--task T | --unknown)
                        Record the dispatch an event became, or that it is
                        unknown whether it did.
  remediation --finding KEY --state S [--detail TEXT] [--task T]
                        Record a repair's state on a finding.
  remediation --finding KEY --state report_acknowledged --detail TEXT
              --expect REPORT_FACT
                        The owner's judgment of a finding that only reports.
                        REPORT_FACT is the report_fact of the awaiting_owner
                        row the owner judged, as status printed it. If the
                        finding's report is another one now, nothing is
                        written and the error prints it.
  remediation --finding KEY --state deploy_resolved --task T --detail TEXT
              --expect REPORT_FACT
                        The owner's record that an awaiting_deploy wait is
                        over: the linked task/plan T shows the fix deployed,
                        or no deployment needed. TEXT says which and cites
                        it. The finding must be closed, its remediation
                        awaiting_deploy with the same task T, and
                        REPORT_FACT the report_fact of its awaiting_owner
                        row as status printed it. Otherwise nothing is
                        written and the error prints the current record.
  A local merge is recorded as awaiting_deploy, also on a finding a scan
  already closed. It is not a failure. Record deployment ownership and the
  next action in remediation detail/task. The row stays in awaiting_owner,
  with closed_reason, through a local closure, the event's ack and later
  scans, until the owner records deploy_resolved. A local closure is not a
  deployment, and no scan or ack records one. A scan that sees the finding
  live again returns it unassigned, without the old remediation.
  fixed_pending_rescan records scan order under the lock. Only a subsequent
  measurement of that finding can return rescan_still_live. Legacy records
  without the boundary return rescan_order_unknown for the owner to review.
  report_fact keeps KEV true (listed), false (not listed) and null (unknown).

  retire --root DIR --evidence TEXT
                        The owner's record that a root is gone for good.

  Config: ~/.safedeps/watch/config.json (population_command, tool_path,
  followups) and ~/.safedeps/watch/exclude (absolute prefixes never read).
  A root on a network mount or behind an excluded prefix is never read; it is
  reported as unmeasured.
EOF
      ;;
    approvals)
      cat <<'EOF'
safedeps approvals migrate [<archive>...] [--json]

  Move into the approvals store the approvals that checks made before it.
  The migration reads the approve lines of ~/.safedeps/advisory.log and of
  each archive named: a rotated advisory.log.<stamp>.gz, or a plain file. For
  each hash a ledger entry confirms, it writes one store line. An entry
  confirms a hash when it stands at the hash's path and its own fields give
  that hash again.

  Not moved, and counted: a line whose hash no entry confirms (each hash is
  named with why), a line that an approve-undone or approve-in-doubt line of
  its hash takes back, a cache hit, a broken line and an input's torn last
  line. A line whose hash the store vouches for already is a duplicate, so a
  second run inserts nothing. An input or a ledger entry that cannot be read
  stops the run before anything is written. A write that fails partway leaves
  the lines before the failure in the store: the run says how many of its
  lines are in the store and how many are not, and exits 4. Run it again to
  insert the rest.

  exit codes: 0 migrated · 4 an input, an entry or the store could not be read or written, or an argument that is not one
EOF
      ;;
    migrate)
      cat <<'EOF'
safedeps migrate [--keep-legacy]

  Migrate legacy ~/.npm-reorg-guard state into ~/.safedeps.
  By default the legacy directory is archived to remove the old active truth path.
EOF
      ;;
    doctor)
      cat <<'EOF'
safedeps doctor [--root <repo>] [--fix] [--json]

  Diagnose this repo's security posture: the per-repo secret-leak lane
  (.gitleaks policy + .githooks/pre-commit + active core.hooksPath + an
  available scanner) plus the global dependency-install gate. Read-only by
  default; exits 1 when the secret-leak lane has gaps.

  --fix   Scaffold the missing policy (hooks init) and activate it (hooks
          install). Non-destructive: existing repo-owned files are kept.

  The scaffolded .gitleaks.toml is a STARTER you own and tune; safedeps owns
  execution (running gitleaks via `safedeps scan secrets`), not the policy.
EOF
      ;;
    hooks)
      cat <<'EOF'
safedeps hooks <install|check|init> [--root <repo>] [--hooks-path <dir>] [--auto]

  init     Scaffold the repo's secret-leak policy from starter templates
           (.gitleaks[.private].toml + .githooks/pre-commit). Non-destructive.
  install  Activate repo-local git hooks (sets core.hooksPath). Requires the
           hook file to exist — run `init` first if the repo has none.
  check    Verify the hooks are active, executable, and a scanner is available.
EOF
      ;;
    *)
      cat <<EOF
safedeps ${SAFEDEPS_VERSION} — multi-ecosystem install safety gate

USAGE
  safedeps <command> [args] [--json] [--no-color]

COMMANDS
  check <ecosystem> <pkg>@<version|range>   Phase 1 advisory gate + ledger approve.
  ledger                                    List approved specs.
  revoke <hash | pkg@version>               Revoke an approved spec.
  re-check                                  Re-query providers for all approved specs.
  watch <scan|status|claim|ack|...>          Daily scan of projects and runtimes.
  migrate                                  Migrate legacy npm-reorg-guard state.
  approvals migrate [<archive>...]          Move pre-store approvals into the approvals store.
  gates [run]                               Release-time repo gates: secret scan, dep audit, hook/CI check.
  scan secrets [--repo|--worktree|--staged] Run gitleaks secret scan (repo profile aware).
  audit [npm|pnpm|yarn|bun]                 Audit dependency lockfiles (auto-detects ecosystem).
  hooks <install|check|init>                Install/verify/scaffold repo-local git hooks.
  doctor [--fix]                            Diagnose this repo's secret-leak lane (--fix scaffolds + activates).
  help [command]                            Show help.
  version                                   Print version.

GLOBAL FLAGS
  --json       Machine-readable JSON output (stable schema).
  --no-color   Disable ANSI colors.

EXIT CODES
  0  clean / approved
  2  CVE found without an upgrade path
  3  CISA KEV match — hard block
  4  input error, provider unavailable, a check that could not finish,
     or a ledger that could not be listed (fail-closed)

ENV
  SAFEDEPS_HOME           default ~/.safedeps
  SAFEDEPS_LEDGER_DIR     default \$SAFEDEPS_HOME/approved-specs. One ledger
                          directory belongs to one SAFEDEPS_HOME.
  GITHUB_TOKEN            optional, used for GHSA enrichment
EOF
      ;;
  esac
}

# ---- main dispatch -----------------------------------------------------------

main() {
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) SAFEDEPS_JSON_MODE=1; shift ;;
      --no-color) SAFEDEPS_NO_COLOR=1; shift ;;
      -h|--help)
        positional+=("help")
        shift
        ;;
      --version)
        positional+=("version")
        shift
        ;;
      --) shift; while [[ $# -gt 0 ]]; do positional+=("$1"); shift; done ;;
      *) positional+=("$1"); shift ;;
    esac
  done

  sf_color_init
  [[ "${positional[0]:-}" != "check" ]] || SF_CHECK_RUNNING=1

  # Announce a moved truth source once per run, at startup rather than from the
  # first provider call: a command that reaches no provider (an empty re-check,
  # a ledger listing) is still a command that ran under a moved source, and the
  # record should not depend on which code path happened to be taken.
  safedeps_announce_truth_sources

  # Said here rather than from providers, because the provider query paths run
  # with their stderr redirected and the notice would be swallowed there.
  if [[ -n "${SAFEDEPS_ADVISORY_LOG_ENV_IGNORED:-}" ]]; then
    printf 'safedeps: SAFEDEPS_ADVISORY_LOG=%s is ignored. The advisory log is where every bypass is recorded, so it cannot be moved on its own — a caller that moves it moves that record out from under whoever reads it. Move SAFEDEPS_HOME to relocate the state root.\n' \
      "${SAFEDEPS_ADVISORY_LOG_ENV_IGNORED}" >&2
  fi

  if [[ ${#positional[@]} -eq 0 ]]; then
    cmd_help
    return 0
  fi

  local cmd="${positional[0]}"
  set -- "${positional[@]:1}"

  case "${cmd}" in
    check)    cmd_check    "$@" ;;
    ledger)   cmd_ledger   "$@" ;;
    revoke)   cmd_revoke   "$@" ;;
    re-check|recheck) cmd_recheck "$@" ;;
    watch)    cmd_watch    "$@" ;;
    migrate)  cmd_migrate  "$@" ;;
    approvals) cmd_approvals "$@" ;;
    gates)    cmd_gates    "$@" ;;
    scan)     cmd_scan     "$@" ;;
    audit)    cmd_audit    "$@" ;;
    hooks)    cmd_hooks    "$@" ;;
    doctor)   cmd_doctor   "$@" ;;
    help)     cmd_help     "$@" ;;
    version)  cmd_version ;;
    *)
      sf_eprintf "safedeps: unknown command '${cmd}'. Try 'safedeps help'."
      return 4
      ;;
  esac
}

main "$@"
